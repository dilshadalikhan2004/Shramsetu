# ============================================
# ShramSetu Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Firebase Auth & DB (Get these from your Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# JWT Secret (Generate a secure random string for production!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-secure-random-string"

# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Google Cloud Translation API (optional)
NEXT_PUBLIC_GOOGLE_TRANSLATE_API_KEY=

# SMS Provider: 'console' (dev), 'fast2sms' (India), 'twilio' (global)
SMS_PROVIDER="console"

# Twilio (required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Fast2SMS (required if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Environment
NODE_ENV="development"

# AI (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
